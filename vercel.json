{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "fluid": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bondsba.com"
        }
      ],
      "destination": "https://bondsba.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.clearpathsbaloan.com"
        }
      ],
      "destination": "https://clearpathsbaloan.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "clearpathsba.com"
        }
      ],
      "destination": "https://clearpathsbaloan.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.clearpathsba.com"
        }
      ],
      "destination": "https://clearpathsbaloan.com/:path*",
      "permanent": true
    },
    {
      "source": "/cash-flow",
      "destination": "/#workspace",
      "permanent": true
    },
    {
      "source": "/contractor-cash-flow",
      "destination": "/#workspace",
      "permanent": true
    },
    {
      "source": "/bond-prep",
      "destination": "/#workspace",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/stripe/:path(.*)",
      "destination": "/api/stripe-api?route=:path"
    },
    {
      "source": "/api/health/:path(.*)",
      "destination": "/api/health-api?route=:path"
    },
    {
      "source": "/api/v1/:path(.*)",
      "destination": "/api/v1-api?route=:path"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "clearpathsbaloan.com"
        }
      ],
      "destination": "/legacy-index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/billing/success",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/bonds",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/bonds/bond-readiness",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/bonds/submission-checklist",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/bonds/surety-packet",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/bonds/wip-analysis",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/checkout",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/contractor-profile",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/financial-spreading",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/free-wip-audit",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/handoff-memo",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/handoff-memos",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/integrations",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/pricing",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/readiness-engine",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/roi-dashboard",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-7a-calculator",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-document-checklist",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-ebitda-dscr-calculator",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-eligibility-screener",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-guaranty-fee-calculator",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-loan-calculator",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-manufacturer-fee-waiver",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba-program-comparison",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba/document-checklist",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba/eligibility",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba/guaranty",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba/lender-packet",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/sba/loan-readiness",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/settings/billing",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/submission-ops-queue",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/submission-workspace",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/surety-dashboard",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/trust-security",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/wip-intelligence",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/wip-review",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/wip-schedule-analyzer",
      "destination": "/legacy-index.html"
    },
    {
      "source": "/workspace",
      "destination": "/legacy-index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' challenges.cloudflare.com cdn.jsdelivr.net fonts.googleapis.com pagead2.googlesyndication.com partner.googleadservices.com ep2.adtrafficquality.google tpc.googlesyndication.com accounts.google.com js.stripe.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' fonts.gstatic.com data:; connect-src 'self' https: challenges.cloudflare.com accounts.google.com dnoceyfxuhekjyiwilsw.supabase.co pagead2.googlesyndication.com googleads.g.doubleclick.net ep2.adtrafficquality.google adservice.google.com www.googletagservices.com api.stripe.com r.stripe.com m.stripe.network; frame-src 'self' challenges.cloudflare.com googleads.g.doubleclick.net tpc.googlesyndication.com www.google.com ep2.adtrafficquality.google accounts.google.com js.stripe.com hooks.stripe.com; base-uri 'self'; form-action 'self' accounts.google.com dnoceyfxuhekjyiwilsw.supabase.co; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/surety-dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sba-loan-calculator",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/financial-spreading",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/wip-schedule-analyzer",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-RateLimit-Limit",
          "value": "100"
        }
      ]
    }
  ]
}
